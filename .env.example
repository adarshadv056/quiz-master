# Flask Core Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_key_in_production

# Database Configuration
# Local SQLite: sqlite:///quiz_master.db
# Cloud PostgreSQL: postgresql://username:password@host.neon.tech/quizmaster?sslmode=require
DATABASE_URL=sqlite:///quiz_master.db

# Server Port
PORT=5000

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@iitm
ADMIN_PASSWORD=admin123
